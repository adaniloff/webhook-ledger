{
    "$schema": "/phpactor.schema.json",
    "language_server_php_cs_fixer.enabled": true,
    "symfony.enabled": true,
    "indexer.exclude_patterns": [
        "/vendor/**/Tests/**/*",
        "/vendor/**/tests/**/*",
        "/var/cache/**/*",
        "/vendor/composer/**/*",
        "/vendor/**/*.phar/**/*",
        "/vendor/webhook-ledger/**/*",
        "/.claude/worktrees/**/*"
    ],
    "language_server_phpstan.enabled": false
}
